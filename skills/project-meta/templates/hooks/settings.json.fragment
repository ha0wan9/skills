{
  "_comment": "Project-meta hooks template fragment. Merge into .claude/settings.json (Claude Code). Do not commit verbatim — instantiate with project-relative script paths and your chosen HARNESS_PROFILE default.",
  "_instantiated_from": "project-meta/templates/hooks/settings.json.fragment",
  "_source_reference": "project-meta/templates/hooks/README.md",

  "env": {
    "HARNESS_PROFILE": "standard"
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/load-agents-md.sh"
          }
        ]
      },
      {
        "_comment": "env-readiness-probe (DASH-051): fires at session start; checks command-resolvability of canonical toolchain entrypoints and scans tracked files for credential-shaped strings. Always exits 0 — advisory only. Independent of the board-guard PreToolUse block.",
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/env-readiness-probe.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_comment": "board-guard: only with --board. Blocks hand-edits to the derived docs/dashboard.html (standard+strict) and, at strict, to the CLI-managed docs/backlog store. Drop this block if the repo has no Project Board.",
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/board-guard.sh"
          }
        ]
      },
      {
        "_comment": "pre-tool-guard (DASH-051): intercepts Bash commands before execution; blocks/warns on destructive patterns (rm -rf on dangerous targets, git reset --hard, git clean -fdx, DROP TABLE/DATABASE, TRUNCATE TABLE). Profile ladder: minimal=silent pass, standard=stderr warning+exit 0, strict=stderr message+exit 2 (block). Independent of board-guard — that guard protects board store files via Edit/Write/MultiEdit events; this guard intercepts Bash commands.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-before-stop.sh"
          }
        ]
      }
    ]
  }
}
